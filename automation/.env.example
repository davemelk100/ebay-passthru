# Copy to .env.local for local dev; production values come from Secret Manager
# via Cloud Run --set-secrets.

# Required: Postgres connection
DATABASE_URL=postgresql://automation:automation@localhost:5432/automation

# Required: eBay app credentials
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=
# Either EBAY_REFRESH_TOKEN or EBAY_AUTH_TOKEN must be set
EBAY_AUTH_TOKEN=

# Optional knobs
EBAY_SITE_ID=0
EBAY_COMPAT_LEVEL=1193
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Optional shared-secret bearer for /admin/* (v0 only — SSO later)
ADMIN_BEARER_TOKEN=
