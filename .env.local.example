# eBay Trading API credentials.
# Get App ID / Dev ID / Cert ID from https://developer.ebay.com/my/keys
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=

# OAuth-enabled RuName from your eBay app's User Tokens settings.
# (Listed on https://developer.ebay.com/my/auth → "User Tokens" → expand the
# RuName with the green "OAuth Enabled" check.) Required by scripts/ebay-oauth.mjs.
EBAY_RU_NAME=

# OAuth tokens — populated automatically by `node scripts/ebay-oauth.mjs`.
# Quote both values: OAuth tokens contain `#`, which dotenv treats as a comment.
EBAY_AUTH_TOKEN=""
EBAY_REFRESH_TOKEN=""

EBAY_SITE_ID=0
EBAY_COMPAT_LEVEL=1193
