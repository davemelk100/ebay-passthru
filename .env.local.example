# eBay Trading API credentials.
# Get these from https://developer.ebay.com/my/keys
EBAY_ENV=sandbox            # "sandbox" or "production"
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_AUTH_TOKEN=            # user auth token for the seller account
EBAY_SITE_ID=0              # 0 = US
EBAY_COMPAT_LEVEL=1193      # Trading API compatibility level
